{
  "name": "home-dev-control-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:install": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "validate": "npm test && npm run test:install && npm run build && npm run test:browser",
    "scan:secrets": "gitleaks dir --redact --no-banner . && gitleaks git --redact --no-banner --log-opts=\"--all --full-history\" ."
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-python": "^6.2.1",
    "@svar-ui/react-filemanager": "^2.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.9",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
